+// Opt-in read-only RNG diagnostics. HLE_HOOK_START retains the original
+// function body. These hooks belong only to the external Dolphin oracle.
+static s32 rng_frame = 0;
+static bool rng_frame_active = false;
+
+void SetRngDiagnosticFrame(s32 frame)
+{
+    const char* path = std::getenv("SSBM_RNG_TRACE");
+    if (!path || !*path)
+        return;
+    auto limit = [](const char* key) -> s32 {
+        const char* value = std::getenv(key);
+        char* end = nullptr;
+        errno = 0;
+        long n = value ? std::strtol(value, &end, 10) : 0;
+        if (!value || !*value || !end || *end || errno ||
+            n < std::numeric_limits<s32>::min() ||
+            n > std::numeric_limits<s32>::max())
+            std::exit(EXIT_FAILURE);
+        return static_cast<s32>(n);
+    };
+    const s32 first = limit("SSBM_RNG_FIRST");
+    const s32 last = limit("SSBM_RNG_LAST");
+    if (first > last)
+        std::exit(EXIT_FAILURE);
+    rng_frame = frame;
+    rng_frame_active = frame >= first && frame <= last;
+}
+
+static void TraceMeleeRng(u32 address)
+{
+    if (!rng_frame_active)
+        return;
+    static FILE* output = nullptr;
+    if (!output)
+    {
+        output = std::fopen(std::getenv("SSBM_RNG_TRACE"), "wb");
+        if (!output)
+            std::exit(EXIT_FAILURE);
+    }
+    const u32 seed_address = Memory::Read_U32(0x804D5F94);
+    if (seed_address < 0x80000000 || seed_address > 0x817FFFFC)
+        std::exit(EXIT_FAILURE);
+    std::fprintf(output,
+        "{\"frame\":%d,\"function\":%u,\"caller\":%u,\"arg3\":%u,"
+        "\"seed_before\":%u,\"stack_callers\":[",
+        rng_frame, address, LR, GPR(3), Memory::Read_U32(seed_address));
+    u32 stack = GPR(1);
+    for (int depth = 0; depth < 5; ++depth)
+    {
+        if (stack < 0x80000000 || stack > 0x817FFFF8 || (stack & 3))
+            break;
+        if (depth)
+            std::fputc(44, output);
+        std::fprintf(output, "%u", Memory::Read_U32(stack + 4));
+        const u32 next = Memory::Read_U32(stack);
+        if (next <= stack)
+            break;
+        stack = next;
+    }
+    std::fprintf(output, "]}\n");
+    if (std::fflush(output) != 0 || std::ferror(output))
+        std::exit(EXIT_FAILURE);
+}
+static void TraceRand() { TraceMeleeRng(0x803804F8); }
+static void TraceRandf() { TraceMeleeRng(0x80380528); }
+static void TraceRandi() { TraceMeleeRng(0x80380580); }
+
