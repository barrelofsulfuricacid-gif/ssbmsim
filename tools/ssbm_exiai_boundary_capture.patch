+// Opt-in diagnostic snapshots at synchronous EXI callbacks. No guest writes.
+// The driver must qualify phase alignment, not assume that a request frame
+// labels finalized state. These raw snapshots are not canonical qualification.
+static void CaptureMeleeBoundary(const char* phase, s32 frame)
+{
+    const char* prefix = std::getenv("SSBM_BOUNDARY_PREFIX");
+    if (!prefix || !*prefix)
+        return;
+    auto readLimit = [](const char* name) -> s32 {
+        const char* value = std::getenv(name);
+        char* end = nullptr;
+        errno = 0;
+        const long parsed = value ? std::strtol(value, &end, 10) : 0;
+        if (!value || !*value || !end || *end || errno ||
+            parsed < std::numeric_limits<s32>::min() ||
+            parsed > std::numeric_limits<s32>::max())
+        {
+            std::fprintf(stderr, "Invalid boundary capture limit: %s\n", name);
+            std::exit(EXIT_FAILURE);
+        }
+        return static_cast<s32>(parsed);
+    };
+    const s32 first = readLimit("SSBM_BOUNDARY_FIRST");
+    const s32 last = readLimit("SSBM_BOUNDARY_LAST");
+    if (first > last)
+    {
+        std::fprintf(stderr, "Boundary capture first exceeds last\n");
+        std::exit(EXIT_FAILURE);
+    }
+    if (frame < first || frame > last)
+        return;
+    static u64 sequence = 0;
+    const u64 ordinal = sequence++;
+    const std::string stem = std::string(prefix) + "." + phase + "." +
+        std::to_string(frame) + "." + std::to_string(ordinal);
+    const std::string memory_path = stem + ".mem1";
+    FILE* output = std::fopen(memory_path.c_str(), "wb");
+    if (!output)
+    {
+        std::perror(memory_path.c_str());
+        std::exit(EXIT_FAILURE);
+    }
+    const size_t size = Memory::REALRAM_SIZE;
+    const size_t written = std::fwrite(Memory::GetPointer(0x80000000), 1, size, output);
+    const int close_result = std::fclose(output);
+    if (written != size || close_result != 0)
+    {
+        std::fprintf(stderr, "Incomplete boundary snapshot: %s\n", memory_path.c_str());
+        std::exit(EXIT_FAILURE);
+    }
+    const std::string metadata_path = stem + ".json";
+    output = std::fopen(metadata_path.c_str(), "wb");
+    if (!output)
+    {
+        std::perror(metadata_path.c_str());
+        std::exit(EXIT_FAILURE);
+    }
+    const int result = std::fprintf(output,
+        "{\"schema\":1,\"phase\":\"%s\",\"requested_frame\":%d,"
+        "\"sequence\":%llu,\"memory_base\":2147483648,\"memory_bytes\":%zu,"
+        "\"claim_boundary\":\"synchronized-exi-diagnostic-not-canonical-qualification\"}\n",
+        phase, frame, static_cast<unsigned long long>(ordinal), size);
+    const int metadata_close = std::fclose(output);
+    if (result < 0 || metadata_close != 0)
+    {
+        std::fprintf(stderr, "Incomplete boundary metadata: %s\n", metadata_path.c_str());
+        std::exit(EXIT_FAILURE);
+    }
+}
