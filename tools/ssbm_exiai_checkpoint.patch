+static std::array<std::unique_ptr<SlippiSavestate>, 16>
+    s_oracle_checkpoints;
+static unsigned int s_oracle_checkpoint_generation = 0;
+
+static void WriteOracleCheckpointStatus(
+    const char* action, unsigned int slot = 0)
+{
+	const std::string path =
+	    "/tmp/pf-exiai-checkpoint-" + std::to_string(getpid()) + ".status";
+	const std::string temporary_path = path + ".tmp";
+	if (FILE* status = fopen(temporary_path.c_str(), "w"))
+	{
+		fprintf(status, "%s %u %u\n", action, slot,
+		        ++s_oracle_checkpoint_generation);
+		fclose(status);
+		rename(temporary_path.c_str(), path.c_str());
+	}
+}
+
+static void DispatchOracleCheckpointRequest()
+{
+	const std::string path =
+	    "/tmp/pf-exiai-checkpoint-" + std::to_string(getpid()) + ".request";
+	char action[16] = {};
+	unsigned int slot = 0;
+	FILE* request = fopen(path.c_str(), "r");
+	if (request == nullptr)
+		return;
+	const int fields = fscanf(request, "%15s %u", action, &slot);
+	fclose(request);
+	unlink(path.c_str());
+	if (fields < 1 || slot >= s_oracle_checkpoints.size())
+		return;
+	if (strcmp(action, "save") == 0)
+	{
+		s_oracle_checkpoints[slot] = std::make_unique<SlippiSavestate>();
+		s_oracle_checkpoints[slot]->Capture();
+		WriteOracleCheckpointStatus("saved", slot);
+	}
+	else if (strcmp(action, "load") == 0 && s_oracle_checkpoints[slot])
+	{
+		s_oracle_checkpoints[slot]->Load({
+		    {0x804BF9D2, 4},
+		    {0x804C3DE4, 20},
+		    {0x804C4560, 44},
+		    {0x804D7760, 36},
+		});
+		WriteOracleCheckpointStatus("loaded", slot);
+	}
+	else if (strcmp(action, "load") == 0)
+	{
+		WriteOracleCheckpointStatus("empty", slot);
+	}
+}
+
